# =========================================================
# RetroGames — .gitignore
# O repositório guarda apenas código-fonte, queries SQL e
# configuração SEM senhas.
# =========================================================

# ---------- .NET (build e IDE) ----------
bin/
obj/
.vs/
*.user
*.suo
*.userprefs
TestResults/
*.trx
*.coverage
coverage*.xml

# ---------- Node / Vite (front-end retrogames.web) ----------
node_modules/
dist/
dist-ssr/
.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---------- Segredos (connection string, senha do admin) ----------
# O .env real nunca é versionado; o modelo .env.example é.
.env
.env.*
!.env.example

# ---------- Editores ----------
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/

# ---------- Sistema operacional ----------
.DS_Store
Thumbs.db
desktop.ini

# ---------- Logs ----------
*.log
logs/
